[Unit]
Description=TOLSTOVKA Telegram Mini App
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/tolstovka
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=tolstovka

Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
